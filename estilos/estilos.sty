\RequirePackage{listings}

% Colores de sintaxis para listings
\definecolor{codebg}{RGB}{248, 249, 250}
\definecolor{codeborder}{RGB}{222, 226, 230}
\definecolor{codekeyword}{RGB}{0, 51, 179}
\definecolor{codestring}{RGB}{6, 125, 23}
\definecolor{codecomment}{RGB}{115, 120, 130}
\definecolor{codenumbers}{RGB}{140, 145, 155}
\definecolor{codeidentifier}{RGB}{36, 41, 47}

% Estilo predeterminado de código
\lstdefinestyle{estilocodigo}{
    backgroundcolor=\color{codebg},
    commentstyle=\color{codecomment}\itshape,
    keywordstyle=\color{codekeyword}\bfseries,
    numberstyle=\tiny\color{codenumbers},
    stringstyle=\color{codestring},
    identifierstyle=\color{codeidentifier},
    basicstyle=\ttfamily\footnotesize\setstretch{1.0},
    columns=flexible,
    breaklines=true,               % Activar ajuste y división automática de líneas (wordwrap)
    breakatwhitespace=false,       % Permite ajustar en cualquier punto si la instrucción es larga
    breakautoindent=true,          % Conserva la indentación del bloque en líneas envueltas
    breakindent=1.5em,             % Sangría visual adicional para líneas continuadas
    captionpos=b,
    keepspaces=false,
    numbers=left,
    numbersep=8pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    frame=single,
    frameround=tttt,
    rulecolor=\color{codeborder},
    xleftmargin=1.8em,
    framexleftmargin=1.5em,
    xrightmargin=0.5em,
    inputencoding=utf8,
    extendedchars=true,
    literate=
        {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
        {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
        {ñ}{{\~n}}1 {Ñ}{{\~N}}1
        {¿}{{?`}}1 {¡}{{!`}}1
        {ü}{{\"u}}1 {Ü}{{\"U}}1
}

% Activar estilo por defecto
\lstset{style=estilocodigo}

% Rótulos de código en español
\renewcommand{\lstlistingname}{Código}
\renewcommand{\lstlistlistingname}{Índice de Códigos}

% Restaurar penalizaciones de partición para permitir wordwrap en listings
\makeatletter
\lst@AddToHook{Init}{\hyphenpenalty=50\exhyphenpenalty=50\tolerance=10000\hbadness=10000}
\makeatother

