\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilos/estilos}[2026/07/31 Configuración de Estilos para Emprendimiento Productivo]

% --- Cargar Configuración Centralizada ---
\input{estilos/configuracion.tex}

% --- Paquetes de Formato e Idioma ---
\RequirePackage[spanish, es-tabla]{babel}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}

% --- Desactivación de División de Palabras (Silabación / Hyphenation) ---
\hyphenpenalty=10000
\exhyphenpenalty=10000
\righthyphenmin=62
\lefthyphenmin=62
\tolerance=2000
\emergencystretch=3em
\hbadness=2000

% --- Especificaciones de la Hoja y Márgenes ---
% Carta: Superior=2.5cm, Inferior=2.5cm, Derecho=2.5cm, Izquierdo=3.0cm
\RequirePackage{geometry}
\geometry{
    letterpaper,
    top=2.5cm,
    bottom=2.5cm,
    left=3.0cm,
    right=2.5cm,
    headheight=15pt
}

% --- Tipografía: Arial (Principal) y Courier (Código Fuente) ---
\RequirePackage{helvet}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{courier}

% --- Interlineado 1.5 ---
\RequirePackage{setspace}
\onehalfspacing

% --- Colores Institucionales ---
\RequirePackage{xcolor}
\definecolor{primary}{RGB}{24, 106, 59}      % Verde empresarial
\definecolor{secondary}{RGB}{35, 155, 86}    % Verde secundario
\definecolor{darktext}{RGB}{33, 33, 33}     % Texto principal

% --- Formato de Títulos y Encabezados (APA 7ma Edición Adaptado) ---
\RequirePackage{titlesec}

% Nivel 1 (Alineado Izquierda, Negrita) - Aplicado a Capítulos
\titleformat{\chapter}[block]
  {\normalfont\Large\bfseries\setstretch{1.0}}
  {\thechapter.}{0.5em}{}
\titlespacing*{\chapter}{0pt}{-15pt}{10pt}

% Versión sin numerar para Nivel 1 (Bibliografía, Anexos, etc. - Alineado Izquierda)
\titleformat{name=\chapter,numberless}[block]
  {\normalfont\Large\bfseries\setstretch{1.0}}
  {}{0pt}{}
\titlespacing*{name=\chapter,numberless}{0pt}{-15pt}{20pt}

% Nivel 2 (Alineado Izquierda, Negrita) - Aplicado a Secciones
\titleformat{\section}
  {\normalfont\large\bfseries\setstretch{1.0}}
  {\thesection}{1em}{}
\titlespacing*{\section}{0pt}{12pt}{6pt}

% Nivel 3 (Alineado Izquierda, Negrita y Cursiva) - Aplicado a Subsecciones
\titleformat{\subsection}
  {\normalfont\large\bfseries\itshape\setstretch{1.0}}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

% Nivel 4 (Sangría 1.27cm, Negrita, Run-in con punto final) - Aplicado a Subsubsecciones
\titleformat{\subsubsection}[runin]
  {\normalfont\normalsize\bfseries\setstretch{1.0}}
  {\thesubsubsection}{1em}{}[.]
\titlespacing*{\subsubsection}
  {1.27cm}{12pt}{0.5em}

% Nivel 5 (Sangría 1.27cm, Negrita y Cursiva, Run-in con punto final) - Aplicado a Párrafos
\titleformat{\paragraph}[runin]
  {\normalfont\normalsize\bfseries\itshape}
  {\theparagraph}{1em}{}[.]
\titlespacing*{\paragraph}
  {1.27cm}{12pt}{0.5em}


% --- Encabezados y Pies de Página ---
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\cfoot{\thepage}
\renewcommand{\headrulewidth}{0pt}

% --- Paquetes para Gráficos y Tablas ---
\RequirePackage{graphicx}
\graphicspath{{imagenes/}} % Ruta por defecto para figuras
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{caption}
\RequirePackage{subcaption}

% --- Enlaces e Hipervínculos ---
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    citecolor=secondary,
    urlcolor=primary,
    pdfstartview=FitH,
    pdftitle={\tituloproyecto},
    pdfauthor={\autorproyecto},
    pdfsubject={\subtituloproyecto}
}

% --- Listas Mejoradas ---
\RequirePackage{enumitem}
\setlist{noitemsep, topsep=3pt}

% --- Bibliografía APA 7ma Edición ---
\RequirePackage[autostyle]{csquotes}
\RequirePackage[
    style=apa,
    backend=biber,
    sortcites=true,
    sorting=nyt
]{biblatex}
\addbibresource{bibliografia/referencias.bib}

% Adaptar etiquetas de biblatex al español
\DeclareLanguageMapping{spanish}{spanish-apa}

% --- Soporte para Código Fuente y Lenguajes de Programación ---
\RequirePackage{listings}

% Colores para la sintaxis de código
\definecolor{codebg}{RGB}{248, 249, 250}
\definecolor{codeborder}{RGB}{222, 226, 230}
\definecolor{codekeyword}{RGB}{0, 51, 179}
\definecolor{codestring}{RGB}{6, 125, 23}
\definecolor{codecomment}{RGB}{115, 120, 130}
\definecolor{codenumbers}{RGB}{140, 145, 155}
\definecolor{codeidentifier}{RGB}{36, 41, 47}

% Configuración del estilo general de código
\lstdefinestyle{estilocodigo}{
    backgroundcolor=\color{codebg},
    commentstyle=\color{codecomment}\itshape,
    keywordstyle=\color{codekeyword}\bfseries,
    numberstyle=\tiny\color{codenumbers},
    stringstyle=\color{codestring},
    identifierstyle=\color{codeidentifier},
    basicstyle=\ttfamily\footnotesize\setstretch{1.0},
    columns=flexible,
    breaklines=true,               % Activar ajuste y división automática de líneas (wordwrap)
    breakatwhitespace=false,       % Permite ajustar en cualquier punto si la instrucción es larga
    breakautoindent=true,          % Conserva la indentación del bloque en líneas envueltas
    breakindent=1.5em,             % Sangría visual adicional para líneas continuadas
    captionpos=b,
    keepspaces=false,
    numbers=left,
    numbersep=8pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=4,
    frame=single,
    frameround=tttt,
    rulecolor=\color{codeborder},
    xleftmargin=1.8em,
    framexleftmargin=1.5em,
    xrightmargin=0.5em,
    inputencoding=utf8,
    extendedchars=true,
    literate=
        {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
        {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
        {ñ}{{\~n}}1 {Ñ}{{\~N}}1
        {¿}{{?`}}1 {¡}{{!`}}1
        {ü}{{\"u}}1 {Ü}{{\"U}}1
}

% Activar estilo por defecto
\lstset{style=estilocodigo}

% Rótulos de código en español
\renewcommand{\lstlistingname}{Código}
\renewcommand{\lstlistlistingname}{Índice de Códigos}

% Restaurar penalizaciones de partición para permitir wordwrap en listings
\makeatletter
\lst@AddToHook{Init}{\hyphenpenalty=50\exhyphenpenalty=50\tolerance=10000\hbadness=10000}
\makeatother

\endinput
