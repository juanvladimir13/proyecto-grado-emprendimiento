% ============================================================
% 2. PAQUETES DE FORMATO, IDIOMA Y CODIFICACIÓN
% ============================================================
\RequirePackage[spanish, es-tabla]{babel}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{etoolbox}

% ============================================================
% 3. CONTROL DE SILABACIÓN (DESACTIVAR GUIÓN DE FIN DE LÍNEA)
% ============================================================
\hyphenpenalty=10000
\exhyphenpenalty=10000
\righthyphenmin=62
\lefthyphenmin=62
\tolerance=2000
\emergencystretch=3em
\hbadness=2000

% ============================================================
% 4. DIMENSIONES DE PÁGINA Y MÁRGENES (Formato Carta BTH)
% ============================================================
% Carta: Izquierdo: 3.0 cm | Derecho, Superior e Inferior: 2.5 cm
\RequirePackage{geometry}
\geometry{
    letterpaper,
    top=2.5cm,
    bottom=2.5cm,
    left=3.0cm,
    right=2.5cm,
    headheight=15pt,
    headsep=0pt
}

% ============================================================
% 5. TIPOGRAFÍA, INTERLINEADO Y ESPACIADO DE PÁRRAFOS
% ============================================================
% Arial (helvet) para texto principal, Courier para código
\RequirePackage{helvet}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{courier}

% Interlineado 1.5 en el cuerpo del texto
\RequirePackage{setspace}
\onehalfspacing

% Espaciado estándar entre párrafos estilo Microsoft Word
% Carga parskip con el espaciado posterior y sangría configurados centralmente
\RequirePackage[
    skip=\espacioposteriorparrafo,
    indent=\sangriaprimeralinea
]{parskip}

% ============================================================
% 6. COLORES INSTITUCIONALES Y DE DISEÑO
% ============================================================
\RequirePackage{xcolor}
\definecolor{primary}{RGB}{24, 106, 59}      % Verde institucional
\definecolor{secondary}{RGB}{35, 155, 86}    % Verde secundario
\definecolor{darktext}{RGB}{33, 33, 33}      % Texto oscuro
\definecolor{lightgray}{RGB}{245, 245, 245}  % Fondo claro

% ============================================================
% 7. FORMATO DE TÍTULOS (Normas APA 7ma Edición Adaptadas)
% ============================================================
\RequirePackage{titlesec}

% Nivel 1 (\chapter) - Alineado a la izquierda, Negrita, sin palabra "Capítulo"
\titleformat{\chapter}[block]
  {\normalfont\Large\bfseries\setstretch{1.0}}
  {\thechapter.}{0.5em}{}
\titlespacing*{\chapter}{0pt}{-15pt}{10pt}

% Nivel 1 sin numerar (Bibliografía, Anexos, Resumen)
\titleformat{name=\chapter,numberless}[block]
  {\normalfont\Large\bfseries\setstretch{1.0}}
  {}{0pt}{}
\titlespacing*{name=\chapter,numberless}{0pt}{-15pt}{20pt}

% Nivel 2 (\section) - Alineado a la izquierda, Negrita
\titleformat{\section}
  {\normalfont\large\bfseries\setstretch{1.0}}
  {\thesection}{1em}{}
\titlespacing*{\section}{0pt}{12pt}{6pt}

% Nivel 3 (\subsection) - Alineado a la izquierda, Negrita y Cursiva
\titleformat{\subsection}
  {\normalfont\large\bfseries\itshape\setstretch{1.0}}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

% Nivel 4 (\subsubsection) - Sangría 1.27cm, Negrita, tipo run-in con punto
\titleformat{\subsubsection}[runin]
  {\normalfont\normalsize\bfseries\setstretch{1.0}}
  {\thesubsubsection}{1em}{}[.]
\titlespacing*{\subsubsection}
  {1.27cm}{12pt}{0.5em}

% Nivel 5 (\paragraph) - Sangría 1.27cm, Negrita y Cursiva, tipo run-in con punto
\titleformat{\paragraph}[runin]
  {\normalfont\normalsize\bfseries\itshape}
  {\theparagraph}{1em}{}[.]
\titlespacing*{\paragraph}
  {1.27cm}{12pt}{0.5em}

% ============================================================
% 8. ENCABEZADOS Y PIES DE PÁGINA
% ============================================================
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\cfoot{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% ============================================================
% 9. TABLAS, FIGURAS Y ROTULACIÓN (APA 7)
% ============================================================
\RequirePackage{graphicx}
\graphicspath{{imagenes/}} % Directorio por defecto para imágenes
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{adjustbox}
\RequirePackage{float}          % Soporte para modificador de posición [H]
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{tikz}           % Generación de esquemas vectoriales y gráficos nativos

% Configuración de etiquetas según Normas APA 7ma Edición
% En APA 7, tanto para tablas como para figuras y gráficos:
% 1. El número va en negrita (labelfont=bf).
% 2. Salto de línea obligatorio entre el número y el título (labelsep=newline).
% 3. El título descriptivo va en cursiva (textfont=it).
% 4. Ambos se ubican ARRIBA del elemento gráfico/tabular y alineados a la izquierda (flush-left).
% 5. position=top asegura que el espaciado (skip) se aplique entre el caption y la figura.
\captionsetup{
    font={small},
    labelfont={bf},
    textfont={it},
    labelsep=newline,
    justification=raggedright,
    singlelinecheck=false,
    skip=6pt,
    position=top
}

% Configuración específica para figuras y gráficos
\captionsetup[figure]{
    font={small},
    labelfont={bf},
    textfont={it},
    labelsep=newline,
    justification=raggedright,
    singlelinecheck=false,
    skip=6pt,
    position=top
}

% Configuración específica para tablas
\captionsetup[table]{
    font={small},
    labelfont={bf},
    textfont={it},
    labelsep=newline,
    justification=raggedright,
    singlelinecheck=false,
    skip=6pt,
    position=top
}

% Subfiguras (a, b, c): etiqueta en negrita y en la misma línea centrada
\captionsetup[sub]{
    font={small},
    labelfont={bf},
    textfont={normalfont},
    labelsep=space,
    justification=centering
}

% Configuración para listings (código fuente): mantiene estilo técnico
\captionsetup[lstlisting]{
    font={small},
    labelfont={bf},
    textfont={normalfont},
    labelsep=colon,
    justification=justified,
    singlelinecheck=false,
    skip=6pt
}

% Columnas flexibles automáticas con tabularx para tablas que respetan \textwidth
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}

% Espaciado vertical óptimo entre filas de tablas
\renewcommand{\arraystretch}{1.15}

% ============================================================
