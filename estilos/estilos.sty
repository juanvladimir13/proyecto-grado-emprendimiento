% ============================================================
% 18. NOTAS Y MACROS DE FIGURAS, IMÁGENES, GRÁFICOS Y TABLAS (NORMAS APA 7)
% ============================================================
% Nota al pie de tabla según APA 7 (alineada a la izquierda, en cursiva "Nota.")
\newcommand{\notatabla}[1]{%
    \par\vspace{\espacionotafigura}%
    {\small\raggedright\noindent\textit{Nota.} #1\par}%
}

% Nota al pie de figura/imagen/gráfico según APA 7 (alineada a la izquierda, en cursiva "Nota.")
\newcommand{\notafigura}[1]{%
    \par\vspace{\espacionotafigura}%
    {\small\raggedright\noindent\textit{Nota.} #1\par}%
}
\newcommand{\notaimagen}[1]{\notafigura{#1}}
\newcommand{\notagrafico}[1]{\notafigura{#1}}

% Macro semántica estandarizada para insertar figuras bajo normas APA 7ma Edición
% Estructura generada:
%   1. \caption{Título} -> Número en negrita + salto + título en cursiva (ARRIBA)
%   2. \label{etiqueta} -> Referencia cruzada
%   3. \centering + \includegraphics -> Imagen o gráfico centrado
%   4. \notafigura{Nota} -> Nota al pie en cursiva (ABAJO)
% Sintaxis: \figuraapa[opciones_includegraphics]{archivo}{Título}{etiqueta}{Nota al pie}
% Ejemplo: \figuraapa[width=0.8\textwidth]{ejemplo_figura.png}{Diagrama de flujo}{fig:flujo}{Elaboración propia.}
\newcommand{\figuraapa}[5][\anchofigurapredeterminado]{%
    \begin{figure}[htbp]
        \caption{#3}%
        \label{#4}%
        \centering
        \includegraphics[#1]{#2}%
        \ifblank{#5}{}{%
            \notafigura{#5}%
        }%
    \end{figure}%
}

% Aliases alternativos de alta legibilidad para figuras, imágenes y gráficos
\newcommand{\insertarfigura}[5][\anchofigurapredeterminado]{%
    \figuraapa[#1]{#2}{#3}{#4}{#5}%
}
\newcommand{\graficoapa}[5][\anchografico]{%
    \figuraapa[#1]{#2}{#3}{#4}{#5}%
}
\newcommand{\insertargrafico}[5][\anchografico]{%
    \figuraapa[#1]{#2}{#3}{#4}{#5}%
}

